# FoodSafe365 Environment Variables
# -----------------------------------------------------------------------------
# Database Configuration
# In production: mandatory PostgreSQL connection URI with verified TLS.
# Example for local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodsafes365

# Cryptographic Session Secret
# Mandatory in production: minimum 32 characters (256-bit entropy).
# Must not be a placeholder, default, or easily guessable value.
# Generate via: openssl rand -base64 32
SESSION_SECRET=your_production_session_signing_secret_min_32_chars_long!

# Optional Client and App Configuration
NEXT_PUBLIC_API_BASE=/api/v1
DEMO_MODE=false
